# =============================================================================
# RIAP — Research Intelligence & Publication Analytics Portal
# Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=riap_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=riap_db
DATABASE_URL=postgresql+asyncpg://riap_user:change_me_in_production@db:5432/riap_db

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
SECRET_KEY=generate_a_long_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini                        # gemini | openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# External APIs — Bibliographic Data Sources
# ---------------------------------------------------------------------------
CROSSREF_API_URL=https://api.crossref.org/works
CROSSREF_EMAIL=your_email_for_crossref_polite_pool@example.com

OPENALEX_API_URL=https://api.openalex.org
OPENALEX_EMAIL=your_email_for_openalex@example.com

SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=

SCOPUS_API_KEY=your_scopus_api_key_here
SCOPUS_API_URL=https://api.elsevier.com/content
SCOPUS_INST_TOKEN=

WOS_API_KEY=your_web_of_science_api_key_here
WOS_API_URL=https://wos-api.clarivate.com/api/wos

# How Google Scholar data enters the system (csv_upload | scrape)
SCHOLAR_INTEGRATION_TYPE=csv_upload

# ---------------------------------------------------------------------------
# Redis (Celery broker & cache)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# PgAdmin (development only — activate with: docker compose --profile tools up)
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
